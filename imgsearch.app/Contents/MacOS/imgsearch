#!/bin/bash
# imgsearch.app 的可执行体：前台 exec python，使 .app 进程即 python 进程。
# → dock 显示图标、右键退出直接 SIGTERM 杀掉 python、释放端口。
# 只在这里开一次浏览器：gui.py 用 inbrowser=False，避免弹出两个页面。
export IMGSEARCH_APP=1
PROJ="/Users/cc/程序/imgsearch"
LOG="$HOME/.imgsearch/app.log"
mkdir -p "$HOME/.imgsearch"
cd "$PROJ" || exit 1

# 端口：从 ~/.imgsearch/config.json 读取（可在「设置」里改，下次启动生效）；读不到用默认
CFG="$HOME/.imgsearch/config.json"
PORT=$(/usr/bin/python3 -c "import json;print(int(json.load(open('$CFG')).get('port',57860)))" 2>/dev/null || echo 57860)
[ -z "$PORT" ] && PORT=57860
URL="http://127.0.0.1:$PORT"

# 已在运行（另一实例）：只开浏览器，本进程退出
if /usr/bin/nc -z 127.0.0.1 "$PORT" >/dev/null 2>&1; then
    /usr/bin/open "$URL"
    exit 0
fi

# 首次：建虚拟环境 + 装依赖
if [ ! -x .venv/bin/python ]; then
    /opt/homebrew/bin/python3.11 -m venv .venv >>"$LOG" 2>&1
    ./.venv/bin/python -m pip install --upgrade pip >>"$LOG" 2>&1
    ./.venv/bin/python -m pip install -r requirements.txt >>"$LOG" 2>&1
fi

# 后台：等端口就绪后开浏览器（首次要同步索引+加载模型，最多等 10 分钟）
(
    for _ in $(seq 1 1200); do
        /usr/bin/nc -z 127.0.0.1 "$PORT" >/dev/null 2>&1 && break
        sleep 0.5
    done
    /usr/bin/open "$URL"
) >>"$LOG" 2>&1 &

# 前台运行 python：本 .app 进程即它，右键退出会把它一并结束
exec ./.venv/bin/python gui.py >>"$LOG" 2>&1
