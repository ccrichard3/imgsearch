# imgsearch 最小版本 Docker 镜像
# 仅内置最小模型 ViT-B-32 (~340MB)，其他模型按需下载

FROM python:3.11-slim

# 安装依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    libheif1 libde265-0 libx265-199 libaom3 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 安装 Python 依赖
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 预下载最小模型 ViT-B-32 到镜像层
RUN python3 -c "import open_clip; \
    model, _, preprocess = open_clip.create_model_and_transforms('ViT-B-32', pretrained='laion2b_s34b_b79k'); \
    print('✓ 最小模型已内置')"

# 复制应用代码
COPY app.py gui.py ./
COPY web/ ./web/

# 数据卷（索引、缩略图、额外模型缓存）
VOLUME /root/.imgsearch
VOLUME /root/.cache/huggingface
VOLUME /library

# 默认端口
EXPOSE 57860

# 环境变量：默认使用国内镜像（可通过 docker run -e 覆盖）
ENV HF_ENDPOINT=https://hf-mirror.com

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s \
  CMD python -c "import socket; s=socket.socket(); s.connect(('127.0.0.1',57860)); s.close()"

CMD ["python", "gui.py"]
